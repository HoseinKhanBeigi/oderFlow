# Postgres for footprint history. Railway injects this automatically.
# Without it the dashboard still runs, but nothing is persisted.
DATABASE_URL=postgres://user:password@localhost:5432/orderflow

PORT=3456
MARKET=perp

# Optional overrides
# SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
# EXCHANGES=binance,bybit,okx
# FOOTPRINT_RETENTION_DAYS=30
# FOOTPRINT_FLUSH_MS=15000
# FOOTPRINT_PUSH_MS=1000
