# Postgres for footprint history. Without it the dashboard still runs, but
# nothing is persisted and the chart has no history beyond the current session.
#
# On Railway this must be a reference to the Postgres service, NOT a literal
# URL. Set it in the service's Variables tab to exactly:
#
#     ${{Postgres.DATABASE_URL}}
#
# Railway does not share DATABASE_URL between services automatically, and it
# will offer to autofill this file's value as-is — which would point the app at
# its own container. For local development, use your own connection string:
#
#     DATABASE_URL=postgres://localhost:5432/orderflow

PORT=3456
MARKET=perp

# Optional overrides
# SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
# EXCHANGES=binance,bybit,okx,bitget,hyperliquid,dydx,bitstamp
# SPOT_EXCHANGES=binance,bybit,okx,bitstamp
# SPOT_IMBALANCE_RATIO=3
# FOOTPRINT_RETENTION_DAYS=30
# FOOTPRINT_FLUSH_MS=15000
# FOOTPRINT_PUSH_MS=1000
